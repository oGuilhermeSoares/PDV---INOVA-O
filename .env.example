# Portal PDV — variáveis de ambiente (a lista completa).
# Copie para .env e ajuste. O .env nunca vai para o git.
# Um teste confere que este arquivo tem exatamente as chaves de src/lib/env-schema.ts.

# --- Obrigatórias ------------------------------------------------------------

# Conexão do banco (Postgres no desenvolvimento; o banco de produção sai do card #2).
DATABASE_URL=postgresql://portal_pdv:portal_pdv@localhost:5432/portal_pdv

# Endereço público do portal (usado nos links dos e-mails).
APP_URL=http://localhost:3000

# development | test | production
NODE_ENV=development

# --- Opcionais por enquanto: viram obrigatórias no card que as usar ----------

# Segredo das sessões do Auth.js (card #6). Gere com: openssl rand -hex 32
AUTH_SECRET=

# Primeiro admin do setor, liberado no primeiro login (card #6).
ADMIN_EMAIL=

# App "Portal PDV" registrado no Entra (cards #3, #4, #6 e #9).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Site SELL OUT E OPERAÇÕES DE PDV no SharePoint (card #4):
# ID do site, da biblioteca de documentos e da pasta LOJAS ATENDIDAS.
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_PASTA_LOJAS_ID=

# Caixa do setor que envia códigos de acesso e avisos (card #9).
EMAIL_REMETENTE=
